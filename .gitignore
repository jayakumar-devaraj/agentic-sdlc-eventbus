.DS_Store
Thumbs.db

# Python
.venv/
__pycache__/
*.egg-info/

# Local compose overrides. The committed .env.example and
# docker-compose.override.example.yml are the templates; what an operator derives from
# them is theirs. Both must sit beside docker-compose.yml for Compose to pick them up
# automatically, which is why they are ignored here at the root rather than in a
# subdirectory.
.env
docker-compose.override.yml
# Left behind by `uv build` / `python -m build`. Neither is ever an input to anything
# here, and building the wheel is part of verifying that the contracts actually ship -
# which should be done often enough that it must not dirty the tree each time.
build/
dist/
.pytest_cache/
.coverage
htmlcov/

# Cross-repo planning docs live outside this repo's tree, so they can't normally
# end up here — this is a defensive backstop in case one is ever copied in by
# mistake. Never commit these.
4-repo-migration-PLAN.md
4-repo-migration-PROMPT.md

# Created by the mermaid diagram check, which npm-installs into the repo.
# CI does this on every run; nothing here is ever a build input.
node_modules/
package-lock.json
